# ==============================================================================
# Aiome API Key / Secret Template (.env.secret.example)
#
# このファイルをプロジェクトルートに `.env.secret` としてコピーし、
# 各環境変数の値を書き換えた後、以下のコマンドで一括インポートしてください。
#
#   $ cargo run --bin abyss-vault -- import --file .env.secret
#
# インポート完了後は、平文の `.env.secret` ファイルは必ず物理削除してください。
#   $ rm .env.secret
# ==============================================================================

# ------------------------------------------------------------------------------
# 🤖 AI Services (AI 関連サービス)
# ------------------------------------------------------------------------------
# Gemini API のシークレットキー
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API のシークレットキー
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Claude) API のシークレットキー
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI TTS (音声合成) サービス用のシークレットキー
TTS_OPENAI_API_KEY=your_tts_openai_api_key_here

# Fal.ai (画像生成など) サービス用のAPIキー
FAL_KEY=your_fal_key_here

# サーチエンジン連携（Tavily等）用のAPIキー
SEARCH_API_KEY=your_search_api_key_here


# ------------------------------------------------------------------------------
# 💳 Commerce (決済・報酬関連サービス)
# ------------------------------------------------------------------------------
# Stripe API の秘密鍵 (sk_test_... または sk_live_...)
STRIPE_API_KEY=your_stripe_api_key_here

# Stripe Webhook の署名検証用シークレット (whsec_...)
# v2 Event Destinations (thin + snapshot) を使う場合、カンマ区切りで複数指定:
#   例: STRIPE_WEBHOOK_SECRET=whsec_thin_xxx,whsec_snapshot_yyy
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Polar.sh API のトークン
POLAR_API_KEY=your_polar_api_key_here

# Polar Webhook の署名検証用シークレット
POLAR_WEBHOOK_SECRET=your_polar_webhook_secret_here

# Tremendous (ギフトカード送付サービス) API のトークン
TREMENDOUS_API_KEY=your_tremendous_api_key_here


# ------------------------------------------------------------------------------
# 🔗 Channel Bridges (外部チャネル連携用)
# ------------------------------------------------------------------------------
# X (旧 Twitter) API の Bearer トークン
X_BEARER_TOKEN=your_x_bearer_token_here

# Discord Bot の認証トークン
DISCORD_TOKEN=your_discord_token_here

# Telegram Bot のトークン
TELEGRAM_TOKEN=your_telegram_token_here


# ------------------------------------------------------------------------------
# 🏗️ Infrastructure (システム・インフラ用内部キー)
# ------------------------------------------------------------------------------
# api-server と key-proxy / 各ノード間の内部通信用共通シークレット
API_SERVER_SECRET=your_api_server_secret_here

# P2P フェデレーション (分散同期) 用のシークレットトークン
FEDERATION_SECRET=your_federation_secret_here

# JWT 署名検証用の秘密鍵 (Base64エンコード済み文字列)
JWT_PRIVATE_KEY_B64=your_jwt_private_key_base64_here

# TimesFM (時系列予測エンジン) の認証トークン
TIMESFM_AUTH_TOKEN=your_timesfm_auth_token_here
