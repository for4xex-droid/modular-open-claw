{
    "name": "@aiome/sentinel",
    "version": "1.0.0",
    "description": "Aiome ContextEngine for Legacy Integration",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "build:native": "napi build --platform --release --manifest-path ../../libs/napi-bridge/Cargo.toml --output-dir .",
        "test": "npx cross-env AIOME_DB_PATH=sqlite://../../workspace/aiome.db jest"
    },
    "aiome": {
        "plugin": true,
        "kind": "context-engine"
    },
    "devDependencies": {
        "@napi-rs/cli": "^3.0.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^20.0.0",
        "cross-env": "^10.1.0",
        "jest": "^30.3.0",
        "ts-jest": "^29.4.9",
        "typescript": "^5.0.0"
    },
    "engines": {
        "node": ">= 20"
    }
}
