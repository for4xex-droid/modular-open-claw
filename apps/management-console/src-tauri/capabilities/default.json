{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "core:tray:default",
    "core:menu:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "obscura" }]
    }
  ]
}
