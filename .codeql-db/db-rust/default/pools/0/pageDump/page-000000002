  let (left, right) = v.split_at_checked(6).unwrap();///     assert_eq!(left, [1, -2, 3, -4, 5, -6]);/// assert_eq!(None, v.split_at_checked(7));/// Divides one mutable slice into two at an index, returning `None` if the/// slice is too short./// if let Some((left, right)) = v.split_at_mut_checked(2) {/// assert_eq!(None, v.split_at_mut_checked(7));/// Returns an iterator over subslices separated by elements that match/// `pred`. The matched element is not contained in the subslices./// assert_eq!(iter.next().unwrap(), &[10, 40]);/// assert_eq!(iter.next().unwrap(), &[20]);/// If the first element is matched, an empty slice will be the first item/// returned by the iterator. Similarly, if the last element in the slice/// is matched, an empty slice will be the last item returned by the/// let slice = [10, 40, 33];/// assert_eq!(iter.next().unwrap(), &[]);/// If two matched elements are directly adjacent, an empty slice will be/// present between them:/// let slice = [10, 6, 33, 20];/// assert_eq!(iter.next().unwrap(), &[10]);split_mut/// Returns an iterator over mutable subslices separated by elements that/// match `pred`. The matched element is not contained in the subslices./// for group in v.split_mut(|num| *num % 3 == 0) {///     group[0] = 1;/// assert_eq!(v, [1, 40, 30, 1, 60, 1]);split_inclusive/// `pred`. The matched element is contained in the end of the previous/// subslice as a terminator./// assert_eq!(iter.next().unwrap(), &[10, 40, 33]);/// If the last element of the slice is matched,/// that element will be considered the terminator of the preceding slice./// That slice will be the last item returned by the iterator./// let slice = [3, 10, 40, 33];/// assert_eq!(iter.next().unwrap(), &[3]);split_inclusive_mut/// match `pred`. The matched element is contained in the previous/// for group in v.split_inclusive_mut(|num| *num % 3 == 0) {///     let terminator_idx = group.len()-1;///     group[terminator_idx] = 1;/// assert_eq!(v, [10, 40, 1, 20, 1, 1]);rsp