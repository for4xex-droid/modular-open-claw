e./// Platform-specific extensions to [`OsStr`].// Note: this file is currently reused in other `std::os::{platform}::ffi` modules to reduce duplication.// Keep this in mind when applying changes to this file that only apply to `unix`.read_vectored_atwrite_vectored_attest_mkfifoplatform// Used for `File::read` on intra-doc linksread_at/// Reads a number of bytes starting from a given offset./// The offset is relative to the start of the file and thus independent/// from the current cursor./// The current file cursor is not affected by this function./// Note that similar to [`File::read`], it is not an error to return with a/// short read./// [`File::read`]: fs::File::read/// use std::os::unix::prelude::FileExt;///     let mut buf = [0u8; 8];///     // We now read 8 bytes from the offset 10.///     let num_bytes_read = file.read_at(&mut buf, 10)?;///     println!("read {num_bytes_read} bytes: {buf:?}");/// Like `read_at`, except that it reads into a slice of buffers./// written to possibly being only partially filled. This method must behave/// equivalently to a single call to read with concatenated buffers.read_exact_at/// Reads the exact number of bytes required to fill `buf` from the given offset./// Similar to [`io::Read::read_exact`] but uses [`read_at`] instead of `read`./// [`read_at`]: FileExt::read_at/// [`io::ErrorKind::Interrupted`] then the error is ignored and the operation/// the buffer, it returns an error of the kind [`io::ErrorKind::UnexpectedEof`].///     // We now read exactly 8 bytes from the offset 10.///     file.read_exact_at(&mut buf, 10)?;///     println!("read {} bytes: {:?}", buf.len(), buf);read_buf_at/// Reads some bytes starting from a given offset into the buffer./// This equivalent to the [`read_at`](FileExt::read_at) method, except that it is passed a/// [`BorrowedCursor`] rather than `&mut [u8]` to allow use with uninitialized buffers. The new/// data will be appended to any existing contents of `buf`./// #![feature(core_io_borrowed_