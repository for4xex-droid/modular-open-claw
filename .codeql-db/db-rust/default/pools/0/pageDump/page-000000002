0 {///         let t = y;///         y = x % y;///         x = t;///     x/// assert_eq!(Rational::new(1, 2), Rational::new(2, 4));/// assert_eq!(Rational::new(2, 3) * Rational::new(3, 4),///            Rational::new(1, 2));/// ## Multiplying vectors by scalars as in linear algebra/// struct Scalar { value: usize }/// struct Vector { value: Vec<usize> }/// impl Mul<Scalar> for Vector {///     fn mul(self, rhs: Scalar) -> Self::Output {///         Self { value: self.value.iter().map(|v| v * rhs.value).collect() }/// let vector = Vector { value: vec![2, 4, 6] };/// let scalar = Scalar { value: 3 };/// assert_eq!(vector * scalar, Vector { value: vec![6, 12, 18] });mul_impl/// The resulting type after applying the `/` operator."div"/// Performs the `/` operation./// assert_eq!(12 / 2, 6);/// The division operator `/`./// ## `Div`idable rational numbers/// use std::ops::Div;/// impl Div for Rational {///     // The division of rational numbers is a closed operation.///     fn div(self, rhs: Self) -> Self::Output {///         if rhs.numerator == 0 {///             panic!("Cannot divide by zero-valued `Rational`!");///         let numerator = self.numerator * rhs.denominator;///         let denominator = self.denominator * rhs.numerator;/// assert_eq!(Rational::new(1, 2) / Rational::new(3, 4),///            Rational::new(2, 3));/// ## Dividing vectors by scalars as in linear algebra/// struct Scalar { value: f32 }/// struct Vector { value: Vec<f32> }/// impl Div<Scalar> for Vector {///     fn div(self, rhs: Scalar) -> Self::Output {///         Self { value: self.value.iter().map(|v| v / rhs.value).collect() }/// let scalar = Scalar { value: 2f32 };/// let vector = Vector { value: vec![2f32, 4f32, 6f32] };/// assert_eq!(vector / scalar, Vector { value: vec![1f32, 2f32, 3f32] });div_impl_integerr" This operation rounds towards zero, truncating any"r" fractional part of the exact result.""This operation will panic if `other == 0`.""This operation will panic if `other == 0` or