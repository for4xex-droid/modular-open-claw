ta structures. For example, it is normally **not** safe to/// build a `String` from a pointer to a C `char` array containing UTF-8/// _unless_ you are certain that array was originally allocated by the/// Rust standard library's allocator./// The ownership of `buf` is effectively transferred to the/// `String` which may then deallocate, reallocate or change the///     let s = String::from("hello");///     // Deconstruct the String into parts.///     let (ptr, len, capacity) = s.into_raw_parts();///     let s = String::from_raw_parts(ptr, len, capacity);///     assert_eq!(String::from("hello"), s);/// Converts a vector of bytes to a `String` without checking that the/// string contains valid UTF-8./// See the safe version, [`from_utf8`], for more details./// This function is unsafe because it does not check that the bytes passed/// to it are valid UTF-8. If this constraint is violated, it may cause/// memory unsafety issues with future users of the `String`, as the rest of/// the standard library assumes that `String`s are valid UTF-8./// let sparkle_heart = unsafe {///     String::from_utf8_unchecked(sparkle_heart)rustc_allow_const_fn_unstable/// Converts a `String` into a byte vector./// This consumes the `String`, so we do not need to copy its contents./// let bytes = s.into_bytes();/// assert_eq!(&[104, 101, 108, 108, 111][..], &bytes[..]);"string_as_str"/// Extracts a string slice containing the entire `String`./// let s = String::from("foo");/// assert_eq!("foo", s.as_str());"string_as_mut_str"as_mut_str/// Converts a `String` into a mutable string slice./// let mut s = String::from("foobar");/// let s_mut_str = s.as_mut_str();/// s_mut_str.make_ascii_uppercase();/// assert_eq!("FOOBAR", s_mut_str);"string_push_str"/// Appends a given string slice onto the end of this `String`./// let mut s = String::from("foo");/// s.push_str("bar");/// assert_eq!("foobar", s);/// Copies elements from `src` range to the end of the string./// Panics if the range has `start_boun