nul(b"foo\0").expect("CStr::from_bytes_with_nul failed"));into_boxed_c_str/// Converts this `CString` into a boxed [`CStr`]./// let c_string = c"foo".to_owned();/// let boxed = c_string.into_boxed_c_str();/// assert_eq!(boxed.to_bytes_with_nul(), b"foo\0");/// Bypass "move out of struct which implements [`Drop`] trait" restriction.from_vec_with_nul_unchecked/// Converts a <code>[Vec]<[u8]></code> to a [`CString`] without checking the/// invariants on the given [`Vec`]./// The given [`Vec`] **must** have one nul byte as its last element./// This means it cannot be empty nor have any other nul byte anywhere else.///     unsafe { CString::from_vec_with_nul_unchecked(b"abc\0".to_vec()) },///     unsafe { CString::from_vec_unchecked(b"abc".to_vec()) }_from_vec_with_nul_uncheckedfrom_vec_with_nul/// Attempts to converts a <code>[Vec]<[u8]></code> to a [`CString`]./// Runtime checks are present to ensure there is only one nul byte in the/// [`Vec`], its last element./// If a nul byte is present and not the last element or no nul bytes/// is present, an error will be returned./// A successful conversion will produce the same result as [`CString::new`]/// when called without the ending nul byte.///     CString::from_vec_with_nul(b"abc\0".to_vec())///         .expect("CString::from_vec_with_nul failed"),///     c"abc".to_owned()/// An incorrectly formatted [`Vec`] will produce an error./// // Interior nul byte/// let _: FromVecWithNulError = CString::from_vec_with_nul(b"a\0bc".to_vec()).unwrap_err();/// // No nul byte/// let _: FromVecWithNulError = CString::from_vec_with_nul(b"abc".to_vec()).unwrap_err();// Turns this `CString` into an empty string to prevent// memory-unsafe code from working by accident. Inline// to prevent LLVM from optimizing it away in debug builds./// Delegates to the [`CStr`] implementation of [`fmt::Debug`],/// showing invalid UTF-8 as hex escapes./// Converts a [`CString`] into a <code>[Vec]<[u8]></code>./// The conversion consumes the [`CString`], and removes the terminating NUL byte./// Creates an empty `CString`./// Converts a `Cow<'a, CStr>` into a `CString`, by copying the contents if they are/// borrowed./// Converts a `&CStr` into a `Box<CStr>`,/// by copying the contents into a newly allocated [`Box`]./// Converts a `&mut CStr` into a `Box<CStr>`,/// Converts a `Cow<'a, CStr>` into a `Box<CStr>`,/// by copying the contents if they are borrowed./// Converts a <code>[Box]<[CStr]></code> into a [`CString`] without copying or allocating./// Converts a <code>[Vec]<[NonZero]<[u8]>></code> into a [`CString`] without/// copying nor checking for inner nul bytes./// Converts a string `s` into a [`CString`]./// This method is equivalent to [`CString::new`]./// Converts a [`CString`] into a [`String`] if it contains valid UTF-8 data./// This method is equivalent to [`CString::into_string`]./// Converts a [`CString`] into a <code>[Box]<[CStr]></code> without copying or allocating./// Converts a [`CString`] into an owned [`Cow`] without copying or allocating./// Converts a [`CStr`] into a borrowed [`Cow`] without copying or allocating./// Converts a `&`[`CString`] into a borrowed [`Cow`] without copying or allocating./// Converts a [`CString`] into an <code>[Arc]<[CStr]></code> by moving the [`CString`]/// data into a new [`Arc`] buffer./// Converts a `&CStr` into a `Arc<CStr>`,/// by copying the contents into a newly allocated [`Arc`]./// Converts a `&mut CStr` into a `Arc<CStr>`,/// Converts a [`CString`] into an <code>[Rc]<[CStr]></code> by moving the [`CString`]/// data into a new [`Rc`] buffer./// Converts a `&CStr` into a `Rc<CStr>`,/// by copying the contents into a newly allocated [`Rc`]./// Converts a `&mut CStr` into a `Rc<CStr>`,/// Creates an empty CStr inside an Rc/// This may or may not share an allocation with other Rcs on the same thread.nul_position/// Returns the position of the nul byte in the slice that caused/// [`CString::new`] to fail./// let nul_error = CString::new("foo\0bar").unwrap_err();//