# --- NURTURE Commercial Configuration ---
NURTURE_DB_PATH=sqlite://data/nurture.db
NURTURE_BIND_ADDR=127.0.0.1 # Docker requires 0.0.0.0
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
TREMENDOUS_API_KEY=...
TREMENDOUS_CAMPAIGN_ID=...
POLAR_WEBHOOK_SECRET=...
NURTURE_DRM_MASTER_KEY=...

# Storage (RTBF Compliance)
# Required when cloud-storage feature is enabled; startup fails if unset (no silent Mock fallback).
S3_BUCKET_NAME=...

# LLM Providers
LLM_PROVIDER_HOST=http://localhost:11434
LLM_PROVIDER_MODEL=llama3:8b

# Aiome OSS 連携
AIOME_API_URL=http://localhost:3015
NURTURE_INTERNAL_SECRET="..."
# Base64 encoded Ed25519 private key for JWT signing/validation (Shared with Aiome)
JWT_PRIVATE_KEY_B64="..."

# OAuth 2.1 (MCP Commerce)
OAUTH_CLIENT_ID=...
OAUTH_CLIENT_SECRET=...
OAUTH_ISSUER_URL=...

# Security & Compliance
PYO3_USE_ABI3_FORWARD_COMPATIBILITY=1
ENFORCE_CSAM_CHECK=true
MAX_BALANCE_THRESHOLD=10000000 # 10M JPY for funding settlement law
# CORS: "*" for dev, specific origin for prod, unset for S2S-only (most restrictive)
# NURTURE_CORS_ORIGIN=https://app.aiome.io
