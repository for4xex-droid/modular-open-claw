# ==============================================================================
# Aiome Production Configuration Template (.env.production)
#
# 本番環境（HetznerなどのLinuxサーバー/Dockerコンテナ）で起動するための設定テンプレート。
# 超重要機密キー（ブートストラップ・キー）は本ファイルに直接記述せず、
# docker-compose.yml などのコンテナ定義から環境変数として安全に注入してください。
# ==============================================================================

# ------------------------------------------------------------------------------
# 🛡️ 1. ブートストラップ・キー (環境変数から注入が必要な超機密情報)
# ------------------------------------------------------------------------------
# 【警告】以下の3項目は本番環境では絶対にこのファイルに書き込まず、
# プロセス起動時のOS環境変数、あるいは docker-compose の env_file/environment から注入してください。
#
# VAULT_MASTER_PASSWORD=あなたのセキュアなVaultマスターパスワード
# VAULT_SECRET=Vaultと外部ノード連携用の最上位共有キー(32バイト以上推奨)
# GEMINI_API_KEY=あなたのGoogle Gemini APIシークレットキー
# JWT_PRIVATE_KEY_B64=あなたのEd25519秘密鍵(Base64) ※Phase 8.2認証に必須

# ------------------------------------------------------------------------------
# 🏗️ 2. セル・マルチテナント・データベース設定
# ------------------------------------------------------------------------------
# マルチインスタンス設計のセルID
CELL_ID=cell-0

# 本番DBへの接続URL (PostgreSQL - docker-composeから注入するためここでは設定しません)
# DATABASE_URL=sqlite://data/cell-0/aiome.db

# AbyssVault セクセスデータ保存用SQLite DB of cell-0
ABYSS_VAULT_PATH=data/cell-0/abyss_vault.db

# ------------------------------------------------------------------------------
# 🔌 3. key-proxy & api-server ポート・ルーティング設定
# ------------------------------------------------------------------------------
# メインの api-server が待ち受けるポート
PORT=3015

# key-proxy (Abyss Vault) が待ち受けるポート
KEY_PROXY_PORT=3017

# key-proxy のバインド設定 (Docker内部ネットワークで閉じない場合は 127.0.0.1 推奨)
BIND_ALL=false

# api-server が key-proxy に接続するためのプロキシURL
KEY_PROXY_URL=http://127.0.0.1:3017

# ------------------------------------------------------------------------------
# 🌐 4. セキュリティ・CORS 設定
# ------------------------------------------------------------------------------
# APIサーバーが許可する CORS オリジン (本番ドメインをカンマ区切りで指定)
# ALLOWED_ORIGINS="https://dashboard.aiome.dev,http://localhost:1420"
ALLOWED_ORIGINS="https://api.aiome.dev,http://localhost:1420"

# ------------------------------------------------------------------------------
# 🤖 5. バックグラウンド AI & モデル設定
# ------------------------------------------------------------------------------
# バックグラウンドプロバイダ（ローカル Ollama 等を本番で使う場合）
BG_LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
BG_LLM_MODEL=gemma4:26b
EMBEDDING_PROVIDER=ruri

# ------------------------------------------------------------------------------
# 📈 6. 外部通信・SSRF防御設定
# ------------------------------------------------------------------------------
# A2A / Sovereign Verifier 連携ポート
A2A_NODE_URL=http://localhost:50051

# 経済コスト引き落とし先 (Project-Nurture) API サーバーURL
NURTURE_API_URL=http://127.0.0.1:3020

# TimesFM (予測側車) 接続URL
TIMESFM_SIDECAR_URL=http://localhost:3025

# ------------------------------------------------------------------------------
# 📝 7. デプロイ・起動手順
# ------------------------------------------------------------------------------
# 1. サーバー上に `data/cell-0` ディレクトリを作成します:
#    $ mkdir -p data/cell-0
#
# 2. ブートストラップキーを含む環境変数を設定して `key-proxy` を起動します:
#    $ export VAULT_MASTER_PASSWORD="xxx"
#    $ export VAULT_SECRET="yyy"
#    $ export GEMINI_API_KEY="zzz"
#    $ export JWT_PRIVATE_KEY_B64="aaa"
#    $ ./key-proxy
#
# 3. 別のプロセスまたはシェルで `api-server` を起動します:
#    $ export VAULT_SECRET="yyy"
#    $ ./api-server
#
# 4. 起動後、管理コンソールまたは abyss-vault CLI から、Stripe APIキーなどの
#    一般シークレットを Vault 内にインポートして連携を確立します。
#    $ ./abyss-vault set STRIPE_API_KEY "rk_live_..."
