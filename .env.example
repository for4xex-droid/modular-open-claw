# Aiome Environment Configuration Example
# Copy this file to .env and configure the values for your setup.

# ==============================================================================
# 🛡️ SECURITY & FEDERATION (REQUIRED FOR LOCAL/CLOUD SYNC)
# ==============================================================================
# The master secret for the API Server. MUST BE CHANGED and is strictly required in production builds.
API_SERVER_SECRET="dev_secret_change_me_immedately"

# Comma-separated list of allowed CORS origins (Required in production)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:1420"

# The secret used for P2P Federation and Samsara Hub synchronization (Legacy).
FEDERATION_SECRET=""

# Base64 encoded Ed25519 private key for JWT signing/validation (Required for Phase 8.2).
# Generate with: openssl genpkey -algorithm ed25519 -outform DER | base64
JWT_PRIVATE_KEY_B64=""

# ==============================================================================
# 🤖 LLM & AI PROVIDERS
# ==============================================================================
# Background Language Model settings for auto-healing and memory distillation.
BG_LLM_PROVIDER="ollama"
BG_LLM_MODEL="qwen3.5:9b"

# Embedding Provider for Memory Crystal vectorization.
# Options: "ruri" (local), "gemini"
EMBEDDING_PROVIDER="ruri"

# API Keys for Cloud LLM Providers (if using them instead of local Ollama/LM Studio)
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""

# TTS Configuration (Phase 10.1 & 13.3)
# Options: "openai", "xtts"
TTS_PROVIDER="openai"
TTS_OPENAI_API_KEY=""
TTS_OPENAI_MODEL="tts-1"
TTS_ENDPOINT="http://localhost:8020"
XTTS_ENDPOINT="http://localhost:18020"
XTTS_SPEAKER="p225"
# ANTHROPIC_API_KEY=""
# TREMENDOUS_API_KEY=""
# TREMENDOUS_SANDBOX="true" # Set to false only in production release
# MASTER_EMAIL=""
# STRIPE_API_KEY="sk_test_mock" # Used for bypassing real stripe checks in CI/CD
# STRIPE_WEBHOOK_SECRET="whsec_xxxxx"
STRIPE_TEST_MODE="true"

# ==============================================================================
# 🔌 EXTERNAL INTEGRATIONS
# ==============================================================================
# API Key for autonomous web search (e.g. Tavily)
SEARCH_API_KEY=""

# ==============================================================================
# 🌐 SERVER PORT & PATHS (ADVANCED)
# ==============================================================================
# Port for the Aiome API Server & Management Console
PORT=3015

# Default working directory for the agent
WORKSPACE_DIR="workspace"

# Storage path for Abyss Vault isolating API Keys and tokens securely
ABYSS_VAULT_PATH="~/.aiome/abyss_vault"

# Master key for voice assets & API key encryption (Required for AbyssVoiceVault)
# Must be 32 bytes (64 hex characters). 
# NOTE: In production, ensure `ulimit -l` is high enough for mlock(2) memory protection.
VAULT_MASTER_KEY=""

# Database Connection URL
# For SQLite:
DATABASE_URL="sqlite://workspace/aiome.db"
# For PostgreSQL (Docker):
# DATABASE_URL="postgres://aiome_user:aiome_password@localhost:5432/aiome"
# TEST_POSTGRES_URL="postgres://aiome_test_user:aiome_test_password@localhost:5433/aiome_test_db"

# ==============================================================================
# 🌐 SAMSARA HUB & EKYC ENDPOINTS
# ==============================================================================
# You typically don't need to change these unless you are self-hosting a Hub
SAMSARA_HUB_REST="https://hub.aiome.dev"
SAMSARA_HUB_WS="wss://hub.aiome.dev/api/v1/federation/ws"

# Stripe Identity (eKYC) Configuration
# STRIPE_API_KEY=""
EKYC_RETURN_URL="http://localhost:1420/ekyc-callback"

# ==============================================================================
# 🧱 INFRASTRUCTURE & DOCKER (SHADOW CLONE)
# ==============================================================================
# Path to store quarantined assets (CSAM/Restricted)
QUARANTINE_DIR="workspace/quarantine"

# Docker image name for Shadow Worker delegation
# This image should have 'aiome-agent' binary installed for --exec mode.
SHADOW_CLONE_IMAGE="aiome-shadow-worker:latest"

# (Currently hardcoded to 3 in DockerConductor for safety)
# SHADOW_CLONE_CONCURRENCY_LIMIT=3

# ==============================================================================
# 🧠 BELIEF CONSISTENCY (Phase 49)
# ==============================================================================
# Threshold for SLM contradiction detection (0.0-1.0, lower is more strict)
# CONTRADICTION_THRESHOLD=0.3

# Required number of evidence entries before allowing SOUL.md revision
# REVISION_EVIDENCE_COUNT=3

# Prometheus Metrics (Optional)
# PROMETHEUS_METRICS_ENABLED=true
# PROMETHEUS_PORT=9090
