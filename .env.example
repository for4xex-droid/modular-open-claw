# Aiome Environment Variables Template
# Copy this file to .env and fill in the values

# --- Core Settings ---
# Database connection string (SQLite)
AIOME_DB_PATH=sqlite://workspace/aiome.db
# Logging level (trace, debug, info, warn, error)
LOG_LEVEL=info
# Port for the API Server
PORT=3015

# --- LLM Provider Settings ---
# Local Ollama connection
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b

# Background LLM (for autonomous tasks)
BG_LLM_PROVIDER=ollama
BG_LLM_MODEL=qwen3.5:9b

# Embedding settings (ruri, gemini, ollama)
EMBEDDING_PROVIDER=ruri
RURI_EMBED_URL=http://localhost:8100

# API Keys (Provide these to the Abyss Vault / Key Proxy)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
SEARCH_API_KEY=your_serpapi_or_google_search_key

# --- Security & Auth ---
# Random string for API Server authentication
API_SERVER_SECRET=change_me_to_a_random_string
# Random string for Abyss Vault (Key Proxy) authentication
VAULT_SECRET=change_me_to_a_secure_vault_secret
# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:1420,http://localhost:5173,http://127.0.0.1:3015

# --- Watchtower (Discord/Telegram Bridge) ---
DISCORD_TOKEN=your_discord_bot_token
TELEGRAM_TOKEN=your_telegram_bot_token
DISCORD_CHAT_CHANNEL_ID=your_discord_channel_id
DISCORD_COMMAND_CHANNEL_ID=your_discord_command_channel_id
# Internal WebSocket URL for Watchtower to connect to API Server
API_WS_URL=ws://127.0.0.1:3015/api/v1/ws

# --- Samsara Hub (Federation) ---
# Secret for node-to-node authentication
FEDERATION_SECRET=your_federation_cluster_secret
# URLs for federated sync
SAMSARA_HUB_REST=http://127.0.0.1:3016
SAMSARA_HUB_WS=ws://127.0.0.1:3016/api/v1/federation/ws

# --- Infrastructure ---
# Directory for the Skill Forge workspace
WORKSPACE_DIR=.
# Abyss Vault (Key Proxy) URl
KEY_PROXY_URL=http://127.0.0.1:3017

# --- Advanced Operations ---
# ガードレールの強制モード（trueで入力バリデーションを厳格化）
ENFORCE_GUARDRAIL=false

# Abyss Vault がリッスンするポート番号（デフォルト: 3010）
KEY_PROXY_PORT=3010

# テストスレッドの最小スタックサイズ（バイト）
# SqliteJobQueue の 60+ async メソッドが生成する巨大な Future に対応
# .cargo/config.toml でも設定済み（64MB = 67108864）
# RUST_MIN_STACK=67108864

# --- Phase B Additions ---
BIND_ALL=false
BIOME_HUB_WHITELIST=*
DATABASE_URL=sqlite://app/data/aiome.db
GEMINI_EMBED_MODEL=text-embedding-004
GEMINI_MODEL=gemini-2.0-flash
HOME=/tmp
QUOTA_DB_PATH=workspace/config/key_proxy_state.json
SAMSARA_HUB_URL=http://localhost:3016
SEARCH_API_ENDPOINT=http://localhost:8100/search
SKILL_FORGE_ENABLED=true
