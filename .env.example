# Aiome Environment Configuration Example
# Copy this file to .env and configure the values for your setup.

# ==============================================================================
# 📦 COMPILATION & BUILD
# ==============================================================================
# Optional path to a specific protoc compiler. Overrides automatic environment detection.
# PROTOC="/opt/homebrew/bin/protoc"

# ==============================================================================
# 🛡️ SECURITY
# ==============================================================================
# The master secret for the API Server. MUST BE CHANGED and is strictly required in production builds.
# Must be at least 16 characters in production builds. The app will panic if this is insecure!
API_SERVER_SECRET="dev_secret_change_me_immediately_for_local_only"

# Required for Nurture communication. Must match across both services.
NURTURE_INTERNAL_SECRET="your_nurture_internal_secret_here"
NURTURE_API_URL="http://127.0.0.1:3020" # Docker: http://nurture-api:3020 / Host: http://localhost:3020
# Comma-separated list of allowed CORS origins (Required in production)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:1420"

# [Deferred to v1.5] The secret used for P2P Federation and Samsara Hub synchronization (Legacy).
FEDERATION_SECRET=""

# Base64 encoded Ed25519 private key for JWT signing/validation (Required for Phase 8.2).
# Generate with: openssl genpkey -algorithm ed25519 -outform DER | base64
JWT_PRIVATE_KEY_B64=""

# ==============================================================================
# 🖼️ GENERATIVE ENGINES (IMAGE/VIDEO)
# ==============================================================================
# The backend engine to use for generative tasks like Image generation.
# Allowed options: "mock", "comfyui", "falai"
# GENERATIVE_ENGINE="mock"

# ComfyUI configuration (Required if GENERATIVE_ENGINE="comfyui")
# COMFYUI_URL="http://localhost:8188"

# Fal.ai API Key (Required if GENERATIVE_ENGINE="falai")
# Get your key at https://fal.ai/
# FAL_KEY=""
# Fal.ai API Endpoint Override (optional, default: https://fal.run)
# FAL_AI_ENDPOINT=""

# ==============================================================================
# 🤖 LLM & AI PROVIDERS
# ==============================================================================
# Background Language Model settings for auto-healing and memory distillation.
BG_LLM_PROVIDER="ollama"
BG_LLM_MODEL="gemma4:26b"

# Default Ollama model for primary LLM (conversation, agentic workflows)
# Supported: gemma4:26b (recommended, MoE, fast), gemma4:31b (dense, quality), qwen3.5:9b (legacy)
# OLLAMA_MODEL="gemma4:26b"

# Embedding Provider for Memory Crystal vectorization.
# Options: "ruri" (local), "gemini"
EMBEDDING_PROVIDER="ruri"

# API Keys for Cloud LLM Providers (if using them instead of local Ollama/LM Studio)
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""

# TTS Configuration (Phase 10.1 & 13.3)
# Options: "openai", "xtts"
TTS_PROVIDER="openai"
TTS_OPENAI_API_KEY=""
TTS_OPENAI_MODEL="tts-1"
# OpenAI TTS Endpoint Override (optional, default: https://api.openai.com/v1/audio/speech)
# OPENAI_TTS_ENDPOINT=""
TTS_ENDPOINT="http://localhost:8020"
XTTS_ENDPOINT="http://localhost:18020"
XTTS_SPEAKER="p225"
# ==============================================================================
# 💰 COMMERCE & AGENT ECONOMY (OPTIONAL)
# ==============================================================================
# Aiome has a built-in Agent Economy (paying for tasks, escrows, purchasing assets).
# If you leave STRIPE_API_KEY commented out, Aiome will automatically run in Mock Mode.
# In Mock Mode, all commerce features work with a fake balance, requiring zero setup!

# STRIPE_API_KEY="sk_test_your_key_here" # Optional - mock mode auto-enabled if missing
# Required if you want to use real Stripe (instead of Mock Mode) to receive payment webhook events securely.
# STRIPE_WEBHOOK_SECRET="whsec_xxxxx"
STRIPE_TEST_MODE="true"

# ANTHROPIC_API_KEY=""
# TREMENDOUS_API_KEY=""
# TREMENDOUS_SANDBOX="true" # Set to false only in production release
# MASTER_EMAIL=""

# ==============================================================================
# 🔌 EXTERNAL INTEGRATIONS
# ==============================================================================
# 🌐 SOVEREIGN VERIFICATION PIPELINE
# Aiome Sovereign Verification and Agent-to-Agent Service configurations
A2A_NODE_URL="http://localhost:50051"
TIMESFM_URL="http://localhost:8083/forecast"
TIMESFM_AUTH_TOKEN=""
GEO_OPTIMIZER_URL="http://localhost:8080/api/v1/optimize"
ABYSS_VAULT_URL="http://localhost:3016"

# 📝 WORDPRESS PUBLISHER
WP_API_URL="https://example.com/wp-json/wp/v2/posts"
WP_API_TOKEN=""

# 📈 SEO INTELLIGENCE PIPELINE
# API Key for autonomous web search (e.g. Tavily). Shared by WebSearchAdapter and SerpAnalysisAdapter.
SEARCH_API_KEY=""

# 🛠️ MCP ECOSYSTEM INTEGRATIONS
# API Keys for Model Context Protocol (MCP) servers
FIRECRAWL_API_KEY=""
EXA_API_KEY=""
BRIGHTDATA_API_KEY=""

# Credentials for Analytics & MCP Integration (used by mcp_servers.json)
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/gcp/service-account.json"
# STRIPE_SECRET_KEY="sk_test_..."

# 🗾 MLIT (国土交通省) Geospatial & Data Platform MCP Servers
# Apply for API keys at:
#   不動産情報ライブラリ: https://www.reinfolib.mlit.go.jp/api/request/
#   国土交通データPF:   https://data-platform.mlit.go.jp/api_docs/usage/introduction.html
# MLIT_REINFOLIB_API_KEY=""
# MLIT_DPF_API_KEY=""

# 🐦 X (Twitter) API Integration
# Used by XSignalProbe for real-time human trend ingestion.
# X_BEARER_TOKEN=""

# ==============================================================================
# 🌐 SERVER PORT & PATHS (ADVANCED)
# ==============================================================================
# Port for the Aiome API Server & Management Console
PORT=3015

# Development mode (set to 1 to use local ./workspace/ paths instead of system paths)
# In production (Tauri), this should NOT be set — AppDataResolver will use:
#   macOS: ~/Library/Application Support/com.aiome.nexus/
#   Linux: ~/.local/share/com.aiome.nexus/
AIOME_DEV_MODE="0"

# Cell-Based Architecture (CBA) identifier.
# When set, all data (DB, artifacts, vault) is namespaced under data/{CELL_ID}/.
# Only [a-zA-Z0-9_-] characters allowed (max 64 chars).
# Leave unset for single-instance (default) mode.
# CELL_ID="cell-0"

# Storage path for Abyss Vault isolating API Keys and tokens securely
ABYSS_VAULT_PATH="~/.aiome/abyss_vault"

# Zero-Trust LLM Proxy endpoint and authentication token
KEY_PROXY_URL="http://127.0.0.1:3017"
VAULT_SECRET=""

# Master key for voice assets & API key encryption (Required for AbyssVoiceVault)
# Must be 32 bytes (64 hex characters). 
# NOTE: In production, ensure `ulimit -l` is high enough for mlock(2) memory protection.
VAULT_MASTER_KEY=""

# Database Connection URL
# For SQLite (auto-resolved by AppDataResolver when not set):
# DATABASE_URL is optional — if unset, AppDataResolver determines the path based on AIOME_DEV_MODE.
# Dev mode: sqlite://workspace/aiome.db
# Prod mode: sqlite://<system_app_data>/aiome.db
# DATABASE_URL="sqlite://workspace/aiome.db"
# For PostgreSQL (Docker):
# DATABASE_URL="postgres://aiome_user:aiome_password@localhost:5432/aiome"
# TEST_POSTGRES_URL="postgres://aiome_test_user:aiome_test_password@localhost:5433/aiome_test_db"

# ==============================================================================
# 🌐 SAMSARA HUB & EKYC ENDPOINTS
# ==============================================================================
# Federation v1.0 parameters
SAMSARA_HUB_URL="https://hub.aiome.dev"
FEDERATION_SYNC_INTERVAL="3600"

# [Deferred to v1.5] You typically don't need to change these unless you are self-hosting a Hub
# Primary: Used by biome proxy routes
SAMSARA_HUB_REST="https://hub.aiome.dev"
SAMSARA_HUB_WS="wss://hub.aiome.dev/api/v1/federation/ws"

# Stripe Identity (eKYC) Configuration
# STRIPE_API_KEY=""
EKYC_RETURN_URL="http://localhost:1420/ekyc-callback"
EKYC_CALLBACK_URL="http://localhost:3015/api/v1/ekyc/webhook"

# ==============================================================================
# 🧱 INFRASTRUCTURE & CONTAINERS (DOCKER/PODMAN)
# ==============================================================================
# Container runtime override. Auto-detected if unset (podman > docker).
# CONTAINER_RUNTIME="podman"
# Path to store quarantined assets (CSAM/Restricted)
# Auto-resolved by AppDataResolver when not set. Override only for custom setups.
# QUARANTINE_DIR="~/.aiome/quarantine"

# Docker image name for Shadow Worker delegation
# This image should have 'aiome-agent' binary installed for --exec mode.
SHADOW_CLONE_IMAGE="aiome-shadow-worker:latest"

# (Currently hardcoded to 3 in DockerConductor for safety)
# SHADOW_CLONE_CONCURRENCY_LIMIT=3

# gRPC Native A2A (Phase 50)
SHADOW_CLONE_GRPC_HOST="127.0.0.1"
SHADOW_CLONE_GRPC_PORT=50051
A2A_GRPC_HEALTH_INTERVAL_MS=5000
A2A_GRPC_CONNECT_TIMEOUT_MS=10000
A2A_AUTH_TOKEN="development_auto_generated"

# OxiLean Formal Verification (CiC Kernel)
# Maximum proof execution time in seconds (default: 10)
OXILEAN_PROOF_TIMEOUT_SECS=10
# Maximum concurrent proof executions (default: 1, prevents LLM thread starvation)
OXILEAN_PROOF_SEMAPHORE_PERMITS=1

A2A_NODE_TOKEN="development_auto_generated"

# ==============================================================================
# 🧠 BELIEF CONSISTENCY (Phase 49)
# ==============================================================================
# Threshold for SLM contradiction detection (0.0-1.0, lower is more strict)
# CONTRADICTION_THRESHOLD=0.3

# Required number of evidence entries before allowing SOUL.md revision
# REVISION_EVIDENCE_COUNT=3

# Prometheus Metrics (Optional)
# PROMETHEUS_METRICS_ENABLED=true
# PROMETHEUS_PORT=9090

# ==============================================================================
# 📈 TIMESFM FORECASTING SIDECAR (Phase 3D)
# ==============================================================================
# Authentication token for the TimesFM sidecar service.
# REQUIRED when running the timesfm-sidecar container.
# Generate with: openssl rand -hex 32

# URL of the TimesFM sidecar (defaults to internal Docker network)
TIMESFM_SIDECAR_URL="http://timesfm-sidecar:3025"

# ==============================================================================
# 🔐 ABYSS VAULT (KEY PROXY) INTEGRATIONS
# ==============================================================================
# WordPress Integration (Abyss Vault)
# The WordPress API token is loaded by the Key Proxy, then completely scrubbed from the environment memory via zeroize (mlockall).
# WP_API_URL="http://wp.local"
# WP_API_TOKEN="your_jwt_or_app_password"

# ==============================================================================
# 🧩 CORE INFRASTRUCTURE CONFIGURATION
# ==============================================================================
# Fail-secure Production Default:
# AIOME_DEV_MODE determines if development mock bypasses (like Stripe whsec_test) are allowed.
# Defaults to `false` in release builds and `true` in debug builds.
# Set to "false" in production to strictly forbid mock secrets!
# AIOME_DEV_MODE="false"

AIOME_DB_PATH="./aiome.db"
AIOME_FORCE_MOCK_PUBLISHER="false"
AIOME_SKIP_OLLAMA="false"
AIOME_STT_ENABLED="false"
BIND_ALL="false"
# [Deferred to v1.5]
# BIOME_HUB_WHITELIST=""
DISCORD_DEFAULT_CHANNEL_ID=""
DISCORD_TOKEN=""
ENFORCE_GUARDRAIL="false"
FRONTEND_STATIC_PATH="./apps/management-console/dist"
GEMINI_EMBED_MODEL="models/text-embedding-004"
GEMINI_MODEL="models/gemini-2.0-flash-exp"
KEY_PROXY_PORT="3000"
LOG_LEVEL="info"
MAX_PROJECT_RULES_CHARS="2000"
MCP_SKILL_MD_INJECTION="false"
OLLAMA_HOST="http://localhost:11434"
QUOTA_DB_PATH="./quota.db"
RURI_EMBED_URL="http://localhost:3016"
SEARCH_API_ENDPOINT="http://localhost:3000/search"
SKILL_FORGE_ENABLED="true"
# Enable Semantic Tool Reviewer (background LLM tool execution guardrail)
ENABLE_TOOL_REVIEWER="true"
KANI_STUB_MODE="false"
KANI_PROOF_TIMEOUT_SECS=600
# Optional: Absolute path for Aegis HotSwap temporary patch workspaces (default: AIOME_DATA_DIR/forge_workspaces)
# FORGE_WORKSPACE_DIR="/path/to/forge_workspaces"
TELEGRAM_TOKEN=""
WORKSPACE_DIR="./workspace"
WP_SDK_ENABLED="false"
X_API_ENDPOINT=""
MCP_ALLOW_LOCALHOST="false"

# ==============================================================================
# 🕸️ GEO (GENERATIVE ENGINE OPTIMIZATION)
# ==============================================================================
# URL for the internal GEO Optimizer service
# Passing threshold for the GEO Quality Gate (0-100)
GEO_CITABILITY_THRESHOLD="80"
# Global toggle for GEO operations
GEO_ENABLED="true"

# ==============================================================================
# 🗃️ SYSTEM & AUTO-INJECTED ENVIRONMENT VARIABLES
# ==============================================================================
# The following variables are typically provided by the OS or build system.
# HOME=""
# USERPROFILE=""
# CARGO_MANIFEST_DIR=""

# Override the application data directory (auto-resolved if not set)
# APP_DATA_DIR=""

# ==============================================================================
# 🔐 VAULT ADVANCED CONFIGURATION
# ==============================================================================
# Secondary password fallback for the Vault
# VAULT_MASTER_PASSWORD=""

# ==============================================================================
# 🛒 POLAR COMMERCE INTEGRATION
# ==============================================================================
# POLAR_API_KEY=""
# POLAR_BASE_URL="https://sandbox-api.polar.sh"
# POLAR_WEBHOOK_SECRET=""

# ==============================================================================
# 🛡️ RLM (RATE LIMITING MANAGER)
# ==============================================================================
# RLM_API_URL="http://localhost:3018"

# ==============================================================================
# 🚨 ADDED FROM PERFECT PLAN AUDIT (P3 Stabilization)
# ==============================================================================
# Anthropic API Key for alternative LLM processing
# ANTHROPIC_API_KEY=""

# Tremendous Sandbox Mode (set to false in production)
# TREMENDOUS_SANDBOX="true"

# Vault Secondary Encryption Password
# VAULT_MASTER_PASSWORD=""

# Vault Data Path
# VAULT_PATH="~/.aiome/vault"

# Container runtime (docker/podman)
# CONTAINER_RUNTIME="podman"

# X (Twitter) Bearer Token for ingestion
# X_BEARER_TOKEN=""

# TEST_POSTGRES_URL="postgres://aiome_test_user:aiome_test_password@localhost:5433/aiome_test_db"

# ==============================================================================
# 🧩 MCP EXTERNAL TOOLS (P1 Ecosystem Expansion & OAuth Token Exchange)
# ==============================================================================
# OAuth Client Credentials for MCP Token Exchange (Phase 1)
# Register OAuth Apps on each provider and set the following credentials.
# Note: Redirect URIs should be set to `http://localhost:3015/api/v1/mcp/oauth/callback`
OAUTH_REDIRECT_URI="http://localhost:3015/api/v1/mcp/oauth/callback"
# TEST_OAUTH_TOKEN_URL_OVERRIDE="http://localhost:3015/api/v1/mock/token"
#
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
#
# SLACK_CLIENT_ID=""
# SLACK_CLIENT_SECRET=""
#
# NOTION_CLIENT_ID=""
# NOTION_CLIENT_SECRET=""
#
# DISCORD_CLIENT_ID=""
# DISCORD_CLIENT_SECRET=""
#
# FIGMA_CLIENT_ID=""
# FIGMA_CLIENT_SECRET=""
#
# Legacy PATs (For manual or legacy MCP servers)
# GITHUB_PERSONAL_ACCESS_TOKEN=""
# DISCORD_TOKEN=""
# NOTION_API_KEY=""
# X_API_KEY=""
# X_API_SECRET=""
# X_ACCESS_TOKEN=""
# X_ACCESS_TOKEN_SECRET=""
OTHER_VAR=my_value

# ==============================================================================
# 📦 BACKUP CONFIGURATION
# ==============================================================================
# AIOME_BACKUP_DIR=./backups    # Backup output directory
# AIOME_MAX_BACKUPS=7           # Number of rolling backups to keep
#
# 🕐 Automatic daily backup (add to crontab -e):
#   0 3 * * * cd /path/to/aiome && bash scripts/backup.sh backup >> /var/log/aiome-backup.log 2>&1
#
# 🕐 systemd timer alternative:
#   See docs/operations/BACKUP.md for production setup

# ==============================================================================
# 🚀 CI & RUNTIME ENVIRONMENT
# ==============================================================================
# CI="true"
# LLM_MODEL="gemma4:26b"
# LLM_PROVIDER="ollama"
