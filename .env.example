# .env.example
# Aiome - The Autonomous AI Operating System Environment Template

# --- Database & Storage ---
AIOME_DB_PATH=workspace/core.db
WORKSPACE_DIR=workspace/
DATABASE_URL=sqlite://workspace/core.db

# --- API & Network ---
PORT=3015
ALLOWED_ORIGINS=http://localhost:1420,http://localhost:5173,http://127.0.0.1:3015
BIND_ALL=false
API_WS_URL=ws://127.0.0.1:3015/api/v1/watchtower/ws

# --- LLM Providers (Local) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
BG_LLM_PROVIDER=ollama
BG_LLM_MODEL=qwen2.5:7b

# --- LLM Providers (Cloud) ---
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Security & Auth ---
# Secrets should be 32+ characters random strings
API_SERVER_SECRET=your_api_server_secret_here
VAULT_SECRET=your_vault_secret_here
FEDERATION_SECRET=your_federation_secret_here

# --- Components: Key Proxy ---
KEY_PROXY_URL=http://127.0.0.1:3017
KEY_PROXY_PORT=3017
QUOTA_DB_PATH=workspace/config/key_proxy_state.json

# --- Components: Samsara Hub ---
SAMSARA_HUB_URL=http://localhost:3016
SAMSARA_HUB_REST=http://localhost:3016/api/v1
SAMSARA_HUB_WS=ws://localhost:3016/ws

# --- Components: Search & Skills ---
SEARCH_API_ENDPOINT=http://localhost:8100/search
SEARCH_API_KEY=your_search_api_key_here
SKILL_FORGE_ENABLED=true
RURI_EMBED_URL=http://127.0.0.1:8100

# --- Integrations (Watchtower) ---
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CHAT_CHANNEL_ID=your_channel_id_here
DISCORD_COMMAND_CHANNEL_ID=your_channel_id_here
DISCORD_LOG_CHANNEL_ID=your_channel_id_here
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Node & Federation ---
NODE_ID=node_01
FEDERATION_PEERS=http://hub.aiome.dev,http://localhost:5000

# --- Feature Flags & Logging ---
LOG_LEVEL=info
JSON_LOGS=false
ENFORCE_GUARDRAIL=true
ADVANCED_EXPERIENCE_MODE=false
OLLAMA_BASE_URL=http://localhost:11434
